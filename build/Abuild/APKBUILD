# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=qt6-httpserver
pkgver=6.10.0
pkgrel=0
pkgdesc="Qt6 HTTP Server"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
depends="
    libc++
    qt6-base
    qt6-websockets
    qnx-io-sock
    "
depends_dev="
    qt6-base-dev
    qt6-websockets-dev
    "
makedepends="$depends_dev
    cmake
    perl
    ninja
    "
subpackages="$pkgname-dev"
options="!check" # No tests
builddir="$srcdir/qthttpserver-everywhere-src-${pkgver/_/-}"
source="https://download.qt.io/official_releases/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qthttpserver-everywhere-src-${pkgver/_/-}.tar.xz"

build() {
    # It's qcc here, but compiled with clang on the selfhosted system
    if [[ $CARCH == "x86_64" ]]; then
        _triplet="qnx-x86-64-qcc"
    elif [[ $CARCH == "aarch64" ]]; then
        _triplet="qnx-aarch64le-qcc"
    else
        die "$CARCH not supported"
    fi

    _warn="-Wno-character-conversion"

    export CC=clang
    export CXX=clang++
    export CFLAGS="$_warn"
    export CXXFLAGS="$_warn"
    export LDFLAGS="-lsocket"
    export LD_LIBRARY_PATH="$builddir/build/lib:$LD_LIBRARY_PATH"

    cmake -B build -G Ninja \
        -DCMAKE_SKIP_RPATH=ON \
        -DQT_QMAKE_TARGET_MKSPEC=$_triplet \
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
        -DFEATURE_pkg_config=ON

    cmake --build build --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

dev() {
    default_dev

    amove usr/lib/qt6/sbom
}

sha512sums="
051065ca1ff62a4b3d8d94c5a388578c9a40a1cda83da737a985125cfe59a24cde98ac5c3a50fee500fdc5597d2bfa6c0f28f345d23a8441a1be2f2256ff9da3  qthttpserver-everywhere-src-6.10.0.tar.xz
"
